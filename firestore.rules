rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Schools collection & Sub-collections (/schools/{schoolId}/timetables, /teachers, /classes...)
    match /schools/{schoolId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // 2. Users collection (/users/{userId})
    match /users/{userId} {
      allow read, write: if true;
    }

    // 3. Fallback catch-all for system documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
